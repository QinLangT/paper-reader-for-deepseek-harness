{
  "name": "@local/dsh-math-reader",
  "version": "1.0.0",
  "type": "module",
  "description": "Typesets the formulas of an assistant reply as KaTeX math and teaches the model to write math with dollar delimiters.",
  "exports": {
    ".": "./index.js",
    "./client": "./client.js",
    "./locale/*.json": "./locale/*.json",
    "./icon": "./icon.svg"
  },
  "files": [
    "index.js",
    "client.js",
    "cordis.patch.yml",
    "locale/*.json",
    "icon.svg",
    "README.md",
    "THIRD-PARTY-NOTICES.md",
    "INSTALL.md"
  ],
  "license": "MIT",
  "dsh": {
    "bundle": {
      "patch": "./cordis.patch.yml"
    },
    "client": {
      "platform": "web",
      "immediately": true,
      "inject": [
        "@deepseek-ai/dsh-client-locale",
        "@deepseek-ai/dsh-client-ui-chat"
      ]
    }
  },
  "keywords": [
    "dsh-plugin",
    "deepseek-harness",
    "katex",
    "math",
    "latex"
  ]
}
